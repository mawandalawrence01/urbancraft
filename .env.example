# --- Database (Neon) -------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?uselibpqcompat=true&sslmode=require"

# Direct (non-pooled) endpoint — migrations only; PgBouncer cannot run DDL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST-WITHOUT-POOLER/DB?uselibpqcompat=true&sslmode=require"

# --- Site ------------------------------------------------------------------
# The canonical origin — sitemap, canonicals, Open Graph tags and the Yo!
# payment callbacks are all derived from it. Include the scheme.
# If you leave it unset on Vercel, the deployment URL is used automatically.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Admin session ---------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=""

# --- Yo! Payments (Uganda mobile money) ------------------------------------
# Sandbox signup: https://sandbox.yo.co.ug/services/yopaymentsdev/signup/start/?sid=1
YO_API_USERNAME=""
YO_API_PASSWORD=""
YO_API_URL="https://sandbox.yo.co.ug/services/yopaymentsdev/task.php"
# Public RSA key supplied by Yo! for verifying IPN callbacks (PEM, \n escaped)
YO_PUBLIC_KEY=""

# --- Vercel Blob (admin image uploads) -------------------------------------
BLOB_READ_WRITE_TOKEN=""
