// UrbanCraft Furniture Workshop — commerce schema
// All monetary values are whole Ugandan Shillings (UGX has no minor unit).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- catalogue

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  imageUrl    String?
  position    Int        @default(0)
  isActive    Boolean    @default(true)

  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")

  products         Product[]         @relation("PrimaryCategory")
  productLinks     ProductCategory[]

  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, position])
  @@index([isActive])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String
  sku       String?
  summary   String?
  /// Rich body stored as an ordered array of { type: "p" | "li", text: string }
  body      Json?
  status    ProductStatus @default(ACTIVE)

  price          Int
  compareAtPrice Int?

  inStock       Boolean @default(true)
  isFeatured    Boolean @default(false)
  leadTimeDays  Int     @default(10)
  warrantyMonths Int    @default(24)

  material   String?
  dimensions String?
  colour     String?

  categoryId String?
  category   Category?         @relation("PrimaryCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  categories ProductCategory[]

  images   ProductImage[]
  variants ProductVariant[]
  reviews  Review[]
  orderItems OrderItem[]

  viewCount Int @default(0)
  position  Int @default(0)
  /// Hand-picked showcase ranking. Lower sorts first; null means not curated.
  /// Drives the home hero and category artwork so imported noise never lands there.
  heroRank  Int?

  seoTitle       String?
  seoDescription String?

  publishedAt DateTime? @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([isFeatured, status])
  @@index([price])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductImage {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String
  alt         String?
  width       Int?
  height      Int?
  /// Tiny inline base64 preview so images fade in instead of popping on slow connections
  blurDataUrl String?
  position    Int     @default(0)
  /// Set on imported photos that carry a third-party watermark or burnt-in
  /// price badge. Surfaced in the admin review queue and never used for hero
  /// or category artwork until replaced.
  needsReview Boolean @default(false)
  reviewNote  String?

  @@index([productId, position])
  @@index([needsReview])
}

/// Quality tiers (Economy / Standard / Top Class) or colour + material options.
model ProductVariant {
  id             String  @id @default(cuid())
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String
  sku            String?
  price          Int
  warrantyMonths Int?
  description    String?
  isDefault      Boolean @default(false)
  position       Int     @default(0)

  orderItems OrderItem[]

  @@index([productId, position])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName String
  rating     Int
  body       String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId, isApproved])
}

// ---------------------------------------------------------------- customers

model Customer {
  id           String    @id @default(cuid())
  phone        String    @unique
  email        String?   @unique
  name         String
  passwordHash String?
  orders       Order[]
  addresses    Address[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String?
  line1      String
  line2      String?
  district   String
  landmark   String?
  isDefault  Boolean  @default(false)

  @@index([customerId])
}

// ---------------------------------------------------------------- orders

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  MOBILE_MONEY
  CASH_ON_DELIVERY
  BANK_DEPOSIT
}

enum PaymentStatus {
  PENDING
  AWAITING_APPROVAL
  PAID
  PARTIALLY_PAID
  FAILED
  REFUNDED
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Snapshot of the buyer, so guest orders stand alone
  contactName  String
  contactPhone String
  contactEmail String?

  deliveryLine1    String
  deliveryLine2    String?
  deliveryDistrict String
  deliveryLandmark String?

  subtotal    Int
  deliveryFee Int @default(0)
  total       Int

  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)

  customerNote String?
  adminNote    String?

  items    OrderItem[]
  payments Payment[]
  events   OrderEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([contactPhone])
  @@index([createdAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Snapshots so a later catalogue edit never rewrites history
  name        String
  variantName String?
  slug        String?
  imageUrl    String?
  unitPrice   Int
  quantity    Int    @default(1)
  lineTotal   Int

  @@index([orderId])
}

model OrderEvent {
  id      String   @id @default(cuid())
  orderId String
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  label   String
  detail  String?
  actor   String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

// ---------------------------------------------------------------- payments

model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method   PaymentMethod
  status   PaymentStatus @default(PENDING)
  amount   Int
  currency String        @default("UGX")

  // Yo! Payments correlation
  msisdn               String?
  transactionReference String?
  mnoReference         String?
  externalReference    String? @unique
  statusCode           String?
  statusMessage        String?
  /// Raw provider payloads, kept for reconciliation and dispute handling
  raw                  Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([orderId])
  @@index([status])
  @@index([transactionReference])
}

// ---------------------------------------------------------------- workshop

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String?
  body        Json?
  coverImage  String?
  images      Json?
  location    String?
  year        Int?
  clientType  String?
  isPublished Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, position])
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

model Enquiry {
  id      String        @id @default(cuid())
  name    String
  phone   String
  email   String?
  subject String?
  message String
  source  String?
  status  EnquiryStatus @default(NEW)
  createdAt DateTime    @default(now())

  @@index([status, createdAt])
}

// ---------------------------------------------------------------- platform

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("ADMIN")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

model DeliveryZone {
  id       String  @id @default(cuid())
  name     String  @unique
  fee      Int
  etaNote  String?
  isActive Boolean @default(true)
  position Int     @default(0)
}

/// Editable site content and configuration, keyed by dotted name.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
